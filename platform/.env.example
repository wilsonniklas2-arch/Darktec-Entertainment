# Create a Supabase project, then add these values to your local .env.local
# and to your deployment provider's encrypted environment settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never expose a service-role key in NEXT_PUBLIC_* variables or browser code.
# Server-only secrets, if ever required, belong in encrypted deployment settings.